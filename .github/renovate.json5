{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "github-actions"
  ],
  "labels": [
    "automerge"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "automerge": true,
      "pinDigests": false
    },
    {
      "description": "Runner image bumps (ubuntu-24.04 → 26.04) are deliberate upgrades — see ff-k8s docs/archive/plans/ubuntu-latest-runner-migration-plan.md",
      "matchDatasources": ["github-runners"],
      "automerge": false,
      "labels": ["dependencies", "renovate", "runner-image"] // deliberately no "automerge" label
    }
  ]
}
